{
  "expo": {
    "name": "HauLink",
    "slug": "HauLink",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "src/assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "haulink",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.HauLink"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "src/assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.anonymous.HauLink",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ],
      "foregroundService": {
        "notificationTitle": "Tracking your location",
        "notificationBody": "Location tracking active in the background."
      }
    },
    "web": {
      "favicon": "src/assets/images/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow HauLink to access your location even when the app is closed or not in use.",
          "locationWhenInUsePermission": "Allow HauLink to access your location while you are using the app."
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "src/assets/fonts/Roboto-Regular.ttf",
            "src/assets/fonts/Roboto-Medium.ttf",
            "src/assets/fonts/Roboto-Bold.ttf"
          ]
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["en"],
            "android": ["en"]
          }
        }
      ]
    ]
  }
}
